# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API (Ask Claude feature)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# BigQuery Configuration
# Set to 'true' to use real BigQuery data, 'false' for mock data
USE_BIGQUERY=false

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=wander-production

# Option 1: Path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option 2: Inline credentials JSON (for Vercel/Railway)
# GOOGLE_CLOUD_CREDENTIALS={"type":"service_account","project_id":"..."}

# Cache TTL in seconds (default: 1 hour)
BIGQUERY_CACHE_TTL=3600
