  "scripts": {
    "build": "velite build && bun run db:push:vercel-prod && next build",
    "db:push:vercel-prod": "[ \"$VERCEL_ENV\" = production ] && drizzle-kit push || true",
    "check": "eslint . --cache && tsc --noEmit",
    "clean": "rm -rf node_modules .next .turbo .cache .velite .eslintcache bun.lock",
    "reinstall": "bun run clean && bun install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:apply:hubspot-sync": "bun --conditions=react-server scripts/apply-hubspot-company-sync-schema.ts",
