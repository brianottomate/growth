    "db:unseed": "bun run scripts/unseed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,json}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,json}\" --cache",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "velite:build": "velite build",
    "velite:dev": "velite --watch",
    "email:dev": "email dev",
    "update:design-system": "pnpm up '@wandercom/design-system-*'",
    "cio:diagnose": "bun run src/scripts/diagnose-cio-assignment.ts",
    "cio:repair": "bun run src/scripts/repair-cio-assignment.ts",
    "product-update:preview": "bun run src/scripts/render-product-update-preview.ts",
    "ai:contracts": "bun --conditions=react-server src/scripts/ai-kernel-gauntlet.ts --contracts-only",
    "ai:gauntlet": "bun --conditions=react-server src/scripts/ai-kernel-gauntlet.ts",
    "test:mcp:protocol": "bun test src/server/mcp/server.protocol.test.ts",
    "smoke:mcp:modern": "node scripts/smoke-mcp-modern.mjs",
    "smoke:preview": "bun scripts/smoke-preview.ts",
    "lab:motion-original": "bun scripts/lab/run-original-property-motion.ts",
