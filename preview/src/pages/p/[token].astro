---
import PreviewLayout from "../../layouts/PreviewLayout.astro";
import { getArtifactByToken } from "../../lib/artifact";

const { token } = Astro.params;
const artifact = token ? await getArtifactByToken(token) : null;

if (!artifact) {
  return new Response("Not found", {
    status: 404,
    headers: {
      "Cache-Control": "private, no-store",
      "X-Robots-Tag": "noindex, nofollow",
    },
  });
}

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const homepage =
  artifact.pages.find((p) => p.kind === "HOMEPAGE") ?? artifact.pages[0];
---

<PreviewLayout title={artifact.config.title} description={artifact.config.description}>
  {/*
    Walking skeleton: proves token → Neon artifact → render. The registry
    section dispatch (RenderPage port) replaces this section listing next.
  */}
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-semibold">{artifact.config.title}</h1>
    <p class="mt-2 text-lg opacity-80">{artifact.config.description}</p>

    {
      homepage && (
        <section class="mt-10">
          <h2 class="text-sm font-medium uppercase tracking-wide opacity-60">
            {homepage.name} — {homepage.sections.length} sections
          </h2>
          <ol class="mt-3 list-decimal pl-5">
            {homepage.sections.map((s) => (
              <li class="py-1 font-mono text-sm">
                {typeof s === "object" && s !== null && "type" in s
                  ? String((s as { type: string }).type)
                  : "unknown"}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      artifact.extractedProperties.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-medium uppercase tracking-wide opacity-60">
            Extracted properties ({artifact.extractedProperties.length})
          </h2>
          <ul class="mt-3 grid grid-cols-2 gap-3">
            {artifact.extractedProperties.map((u) => (
              <li class="rounded border p-3 text-sm">{u.name}</li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</PreviewLayout>
