---
import PreviewLayout from "../../layouts/PreviewLayout.astro";
import { RenderSections } from "../../components/RenderSections";
import { getArtifactByToken } from "../../lib/artifact";

const { token } = Astro.params;
const artifact = token ? await getArtifactByToken(token) : null;

if (!artifact) {
  return new Response("Not found", {
    status: 404,
    headers: {
      "Cache-Control": "private, no-store",
      "X-Robots-Tag": "noindex, nofollow",
    },
  });
}

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<PreviewLayout
  title={artifact.config.title}
  description={artifact.config.description}
  faviconUrl={artifact.config.faviconUrl}
>
  <main>
    <RenderSections artifact={artifact} client:load />
  </main>
</PreviewLayout>
