---
import { Font } from "astro:assets";
import { APP_BASE_URL } from "astro:env/server";
import "../styles/global.css";
import ProspectClaimDialog from "./ProspectClaimDialog.astro";
import ProspectPreviewBar from "./ProspectPreviewBar.astro";
import { buildClaimUrl, type ClaimIdentity } from "../lib/claim";

export type Props = {
  title?: string;
  description?: string;
  faviconUrl?: string | null;
  /** Business name shown in the preview chrome. Omit to render without chrome. */
  businessName?: string;
  /** The prospect's real site, when known. Drives the "Compare with" link. */
  sourceUrl?: string;
  /** Fallback for the claim hand-off when no source URL was captured. */
  prospectDomain?: string;
  claim?: ClaimIdentity;
};

const {
  title,
  description,
  faviconUrl,
  businessName,
  sourceUrl,
  prospectDomain,
  claim,
} = Astro.props;

// Kept in the URL on purpose: these links travel by someone copying the
// address bar. The cookie set in middleware means navigation works without it,
// but every internal link still carries `?t=` so any page can be copied and
// shared as-is. See src/middleware.ts for the full policy.
const previewToken = Astro.locals.previewToken;

// The chrome is what turns a rendered artifact into a preview a prospect can
// act on. It needs a business name and a claim identity; anything less renders
// the bare site (useful for the interstitial and for screenshotting).
const showChrome = Boolean(businessName && claim);
// The hand-off always carries a website, even when no source URL was captured
// — onboarding prefills from it, and the prospect's domain is the next best
// truth we hold. Display is stricter: "Compare with" only appears for a real
// captured source, so the chrome never links somewhere we did not crawl.
const claimWebsite =
  sourceUrl ?? (prospectDomain ? `https://${prospectDomain}` : "");
const claimUrl =
  businessName && claim
    ? buildClaimUrl({
        appBaseUrl: APP_BASE_URL,
        businessName,
        website: claimWebsite,
        identity: claim,
      })
    : undefined;

// Title/description are the prospect's own — this must read as their site, not
// as a Wander tool. `data-theme` + `color-scheme` mirror the production sites
// Layout; without the attribute the design-system token layer never activates.
const pageTitle = title ?? "Website preview";
---

<!doctype html>
<html lang="en" data-theme="light" style="color-scheme: light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />

    <link rel="icon" href={faviconUrl ?? "/favicon.ico"} sizes="any" />

    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />

    <Font cssVariable="--font-instrument-sans" preload />
  </head>
  <!-- No h-svh/overflow-hidden here: the gallery app this was seeded from pins
       the viewport, which clips a full-page site and blocks scrolling. -->
  <body class="bg-surface-primary text-primary isolate">
    {
      showChrome && claimUrl && (
        <>
          <ProspectPreviewBar
            businessName={businessName!}
            claimUrl={claimUrl}
            sourceUrl={sourceUrl}
            claimable={claim!.kind === "monolith"}
          />
          <ProspectClaimDialog
            businessName={businessName!}
            claimUrl={claimUrl}
            sourceUrl={sourceUrl}
            claimable={claim!.kind === "monolith"}
          />
        </>
      )
    }
    <div class="@container">
      <slot />
    </div>

    {
      previewToken && (
        <script is:inline define:vars={{ previewToken }}>
          // Carry the preview token onto internal links so the address bar
          // stays copy-pasteable on every page. Bubble phase on purpose: the
          // claim dialog intercepts booking links in the capture phase and
          // stops propagation, so those never reach this handler.
          document.addEventListener("click", function (event) {
            var target = event.target;
            if (!(target instanceof Element)) return;
            var anchor = target.closest("a[href]");
            if (!anchor || anchor.target === "_blank") return;

            var destination;
            try {
              destination = new URL(anchor.getAttribute("href"), window.location.href);
            } catch (error) {
              return;
            }
            if (destination.origin !== window.location.origin) return;
            if (destination.searchParams.has("t")) return;

            destination.searchParams.set("t", previewToken);
            anchor.setAttribute("href", destination.toString());
          });
        </script>
      )
    }
  </body>
</html>
