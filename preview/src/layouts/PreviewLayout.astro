---
import { Font } from "astro:assets";
import "../styles/global.css";

export type Props = {
  title?: string;
  description?: string;
  faviconUrl?: string | null;
};

const { title, description, faviconUrl } = Astro.props;

// Title/description are the prospect's own — this must read as their site, not
// as a Wander tool. `data-theme` + `color-scheme` mirror the production sites
// Layout; without the attribute the design-system token layer never activates.
const pageTitle = title ?? "Website preview";
---

<!doctype html>
<html lang="en" data-theme="light" style="color-scheme: light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />

    <link rel="icon" href={faviconUrl ?? "/favicon.ico"} sizes="any" />

    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />

    <Font cssVariable="--font-instrument-sans" preload />
  </head>
  <!-- No h-svh/overflow-hidden here: the gallery app this was seeded from pins
       the viewport, which clips a full-page site and blocks scrolling. -->
  <body class="bg-surface-primary text-primary isolate">
    <div class="@container">
      <slot />
    </div>
  </body>
</html>
