---
import { sourceDomainOf } from "../lib/claim";

// Ported from sites#919. Two adaptations: the copy forks for previews that
// cannot be attached to a workspace yet, and the booking-link intercept no
// longer assumes a `/p/<id>` prefix, so it behaves the same under /p/, /m/,
// or a per-prospect subdomain.

interface Props {
  businessName: string;
  claimUrl: string;
  sourceUrl?: string;
  claimable?: boolean;
}

const { businessName, claimUrl, sourceUrl, claimable = true } = Astro.props;

const sourceDomain = sourceDomainOf(sourceUrl);

const claimableSteps = [
  ["Create or sign in to your account", "No card needed."],
  ["The draft lands in your workspace", "Edit every section, or start over."],
  ["Connect your PMS", "Live properties, rates, and availability."],
  ["Publish when you are ready", "On your domain, or a wander.com address."],
];

// A growth-native preview has no monolith site to attach, so the second step
// is a person, not an automatic hand-off. Saying that plainly beats promising
// an attach that would silently fail.
const unclaimableSteps = [
  ["Create or sign in to your account", "No card needed."],
  ["We rebuild this draft in your workspace", "We carry over the sections you liked."],
  ["Connect your PMS", "Live properties, rates, and availability."],
  ["Publish when you are ready", "On your domain, or a wander.com address."],
];

const steps = claimable ? claimableSteps : unclaimableSteps;
---

<dialog
  data-prospect-claim-dialog
  aria-labelledby="prospect-claim-title"
  class="fixed inset-x-0 top-auto bottom-0 m-0 max-h-[92svh] w-full max-w-none overflow-y-auto rounded-t-3xl p-0 shadow-2xl backdrop:bg-black/55 sm:inset-0 sm:m-auto sm:w-[min(92vw,27.5rem)] sm:rounded-[20px]"
>
  <div class="mx-auto mt-2 h-1 w-9 rounded-full bg-neutral-200 sm:hidden" aria-hidden="true"></div>
  <div class="flex flex-col p-5 pt-4 sm:p-7">
    <div class="flex min-w-0 flex-col gap-[3px] pb-4 sm:pb-5">
      <span class="truncate text-[13px] font-semibold text-neutral-950">{businessName}</span>
      <span class="truncate text-xs text-neutral-500">
        {sourceDomain ? `${sourceDomain} · draft built by Wander` : "Draft built by Wander"}
      </span>
    </div>

    <h2
      id="prospect-claim-title"
      class="font-serif text-[22px] leading-[26px] font-semibold tracking-[-0.01em] text-neutral-950 sm:text-2xl sm:leading-7"
    >
      Make this site yours
    </h2>
    <p class="mt-2 text-[15px] leading-[22px] text-neutral-600 sm:mt-2.5 sm:text-base sm:leading-6">
      {
        claimable
          ? "Claiming moves this draft into your own WanderOS workspace. Nothing is published, and no card is needed."
          : "Start a WanderOS workspace and we will rebuild this draft inside it. Nothing is published, and no card is needed."
      }
    </p>

    <ol class="mt-[18px] flex flex-col gap-3 sm:mt-[22px] sm:gap-3.5">
      {
        steps.map(([title, detail], index) => (
          <li class="flex items-start gap-3">
            <span class="mt-px flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full bg-neutral-900 text-[11.5px] font-semibold text-white">
              {index + 1}
            </span>
            <span class="text-sm leading-[19px]">
              <strong class="font-semibold text-neutral-950">{title}</strong>
              <span class="mt-0.5 block text-[13px] leading-[18px] text-neutral-600">{detail}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <div class="mt-[22px] h-px bg-neutral-200"></div>
    <p class="mt-4 text-[13px] leading-[19px] text-neutral-500">
      {
        claimable
          ? "This private preview link closes once the site moves into your workspace."
          : "This private preview link is not indexed and is meant only for you."
      }
    </p>

    <!-- Reversed on both axes so the primary leads: stacked on top of "Keep browsing" on
         mobile, and to its left on desktop, while the DOM keeps the dismissive action first. -->
    <div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row-reverse sm:gap-2.5">
      <button
        type="button"
        data-claim-dialog-close
        class="h-12 rounded-full border border-neutral-300 px-5 text-base font-semibold text-neutral-900 transition-colors hover:bg-neutral-100 sm:flex-none"
      >
        Keep browsing
      </button>
      <a
        href={claimUrl}
        class="flex h-12 items-center justify-center rounded-full bg-neutral-950 px-5 text-base font-semibold text-white transition-colors hover:bg-neutral-700 sm:flex-1"
      >
        {claimable ? "Claim this site" : "Start a workspace"}
      </a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-prospect-claim-dialog]");

  for (const trigger of document.querySelectorAll("[data-claim-dialog-trigger]")) {
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      dialog?.showModal();
    });
  }

  dialog
    ?.querySelector("[data-claim-dialog-close]")
    ?.addEventListener("click", () => dialog.close());

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });

  if (dialog) {
    document.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest("[data-prospect-claim-dialog], [data-prospect-preview-bar]")) return;

        const anchor = target.closest<HTMLAnchorElement>("a[href]");
        const href = anchor?.getAttribute("href");
        const destination = href ? new URL(href, window.location.href) : undefined;
        // Routing-agnostic: strip an optional preview prefix so the intercept fires
        // the same way on `/p/<token>/property/…`, `/m/<id>/property/…`, and on a
        // per-prospect subdomain where there is no prefix at all.
        const pathname = destination?.pathname.replace(/^\/[pm]\/[A-Za-z0-9_-]+/, "") ?? "";
        const isBookingLink =
          destination?.origin === window.location.origin &&
          (pathname === "/s" || pathname.startsWith("/s/") || pathname.startsWith("/property/"));
        const isSearchSubmit = Boolean(
          target.closest(
            '[data-search-submit], form[action="/s"] button[type="submit"], form[action*="/s?"] button[type="submit"]',
          ),
        );

        if (!isBookingLink && !isSearchSubmit) return;
        event.preventDefault();
        event.stopPropagation();
        dialog.showModal();
      },
      true,
    );
  }
</script>
