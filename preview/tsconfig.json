{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["../website/src/*"],
      "@/lib/*": ["../website/src/shared/lib/*"],
      "@/hooks/*": ["../website/src/shared/hooks/*"],
      "@/ui/*": ["../website/src/shared/ui/*"],
      "@wandercom/website-registry/*": ["../../packages/website-registry/src/*"],
      "@registry/*": ["../../packages/website-registry/src/*"]
    }
  }
}
