# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.ts"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
ADMIN_TOKEN="" # 32+ chars for cron/auth protection

# GitHub Packages (required to install @wandercom/* private packages — see .npmrc)
GH_PACKAGES_TOKEN=""

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/myapp"
NODE_ENV="development"

# Email (optional)
RESEND_API_KEY=""

# AI Services
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
FAL_AI_API_KEY=""
REPLICATE_API_TOKEN=""

# Customer.io
CUSTOMER_IO_SITE_ID=""
CUSTOMER_IO_API_KEY=""
CUSTOMER_IO_APP_KEY=""
CUSTOMERIO_WEBHOOK_SECRET=""
CUSTOMERIO_WEBHOOK_BEARER_TOKEN=""

# Outreach (optional)
OUTREACH_S2S_GUID=""
OUTREACH_PRIVATE_KEY=""
OUTREACH_INSTALL_ID=""
OUTREACH_OAUTH_CLIENT_ID=""
OUTREACH_OAUTH_CLIENT_SECRET=""
OUTREACH_WEBHOOK_SECRET=""

# BigQuery (required)
BIGQUERY_PROJECT_ID=""
BIGQUERY_DATASET_ID=""
# Optional: service account JSON string. If omitted, ADC is used.
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
# Optional: base64-encoded service account JSON (preferred on Vercel)
GCP_SA_JSON_B64=""

# Meta Ads (required for meta-sync cron)
# System User token — never expires, get from:
#   Meta Business Manager → Business Settings → System Users → Generate Token
FB_SYSUSER_TOKEN=""
# Fallback regular user token — expires in 60 days (use System User above instead)
META_ACCESS_TOKEN=""
# Ad account ID — format: act_XXXXXXXXXX
# Your account: act_885632589057558 (confirm in Meta Business Manager → Ad Accounts)
META_AD_ACCOUNT_ID="act_885632589057558"
# Meta lead ads → growth (Doppler wander-growth has the real values)
META_LEADS_ACCESS_TOKEN=""
META_LEADS_APP_SECRET=""
META_LEADGEN_VERIFY_TOKEN=""
# ISO timestamp; leads created at/after it go to the HubSpot inbound router
META_LEADGEN_ROUTE_FROM=""

# Minerva (optional)
MINERVA_API_URL=""
MINERVA_API_KEY=""

# Web Scraping (optional)
FIRECRAWL_API_KEY=""

# X / Twitter API v2 (read-only monitoring)
X_CONSUMER_KEY=""           # aka "API Key"
X_CONSUMER_SECRET=""        # aka "API Key Secret"
X_BEARER_TOKEN=""           # app-only auth for read endpoints

# Client-side (NEXT_PUBLIC_*)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_MAPBOX_PUBLIC_API_KEY=""
NEXT_PUBLIC_VERCEL_ENV="development"

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=""

# Bright Data — dataset scrapes for competitor/peer social posts (optional)
BRIGHT_DATA_API_KEY=""

# Cloudflare media library — R2 (images/files) + Stream (video)
CLOUDFLARE_ACCOUNT_ID="026c91fc5cd3dd05f22c65e8f237ca2c"
R2_ACCESS_KEY_ID=""          # R2 → Manage API tokens (S3 access key id)
R2_SECRET_ACCESS_KEY=""      # S3 secret access key
R2_BUCKET="growth"           # dedicated growth media bucket
R2_PREFIX=""                 # optional key prefix (only when sharing a bucket)
R2_PUBLIC_BASE_URL=""        # bucket public URL — custom domain or pub-xxxx.r2.dev (enable Public access)
CLOUDFLARE_STREAM_TOKEN=""   # API token with Stream:Edit on the Wander account
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""  # from the Stream webhook you create (optional)
# NEXT_PUBLIC_STREAM_SUBDOMAIN defaults to customer-qmayhafe7iottqnh; override only if the account changes

# HubSpot gateway (docs/hubspot-gateway-plan.md)
HUBSPOT_ACCESS_TOKEN_OPERATED=""   # shared private-app token (same app as wander.com; gateway scopes added to it)
HUBSPOT_GATEWAY_API_TOKEN=""       # 32+ char bearer for /api/hubspot/v1/* callers (openssl rand -hex 32)

# Monolith (WanderOS) API — used to trigger pregen prospect builds via
# /internal/prospects/*. The key is an OsApiKey scoped to the Wander org with
# readOnly=false; it is not scoped per endpoint (see makeServiceApiKeyGuard in
# the monolith for how an endpoint can be locked to one key).
WANDER_API_URL=https://api.wander.com  # prod; staging is https://api.staging.wander.com
WANDER_API_KEY=
